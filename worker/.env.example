# Supabase → Project Settings → Database → Connection string (Session pooler)
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# GitHub → Settings → Developer settings → Fine-grained token (public repo read-only is enough)
GITHUB_TOKEN=
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Run: python scripts/telegram_chat_id.py
TELEGRAM_CHAT_ID=
POLL_SECONDS=60
